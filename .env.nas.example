# Tinker NAS 私有实例环境变量
# 复制为 .env.nas 后填实际值 · .env.nas 已被 .gitignore 忽略
# 用法: docker compose --env-file .env.nas -f docker-compose.nas.yml up -d --build

# Tailscale 一次性认证密钥 · 从 tailscale.com 后台 Settings → Keys → Generate auth key
# 让 NAS 自动进你的 tailnet · 队友进同一 tailnet 后就能访问
TS_AUTHKEY=

# 队友访问这个实例用的地址 · 给 magic link / 分享链接拼绝对 URL 用
# 走 Tailscale 就填 http://<nas 的 tailnet ip>:8788 (up 之后在 Tailscale 后台看这个 100.x 地址)
BASE_URL=

# 服务端 LLM (调研压缩 + 归档) · 跟 watcher 用同一个 key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ⭐ 绿联上"哇咔咔"那个共享文件夹在 NAS 里的真实路径
# 在绿联文件管理里看这个共享文件夹的路径 · 类似 /volume1/xxx 或 UGOS 给的挂载路径
NAS_FILES_DIR=/绝对路径/哇咔咔

# 登录要发邮件才填 (不填队友没法用 magic link 登录)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
