# Tinker server 环境变量
#
# 复制为 .env 后填上实际值。.env 已在 .gitignore 中。
# 在生产环境直接通过 docker / systemd 注入即可。

# ============================================
# 基础
# ============================================

# 端口 (Railway/Render 会自动注入)
PORT=8788

# 环境 (development / production)
NODE_ENV=development

# 日志级别 (trace / debug / info / warn / error / fatal)
LOG_LEVEL=info

# ============================================
# CORS
# ============================================

# 允许的前端 origin · 多个用逗号分隔
# 开发: http://localhost:8788
# 生产: https://tinkers.ink,https://yourdomain.com
# 留空 = 允许所有 (alpha 期 OK · 生产收紧)
CORS_ORIGINS=

# ============================================
# Rate limiting
# ============================================

# /api/action 每 IP 每分钟最多请求
RATE_LIMIT_ACTION=60

# /api/state 每 IP 每分钟最多请求
RATE_LIMIT_STATE=300

# ============================================
# 传输层清理 (bridge 清道夫)
# ============================================
# bridge 消息和 handoff blob 是过路的 · 送到就没用 · 定时删过期的把存储焊在上限内
# 存档类 (update/method/digest) 不受影响 · 永久留
# 消息保留天数 (默认 30)
BRIDGE_MSG_TTL_DAYS=30
# handoff blob 保留天数 (默认 14 · blob 是重料 · 更激进)
BRIDGE_BLOB_TTL_DAYS=14

# ============================================
# 数据
# ============================================

# data.json 路径 (默认 ./data.json)
# 容器化部署时挂 volume 到这里
# DATA_FILE=/data/tinker/data.json

# ============================================
# 服务端 LLM (只给调研资料投喂用)
# ============================================
#
# 默认 server 不碰模型 · 所有 LLM 调用都在 CLI 端 · 用用户自己的 key。
# 唯一例外:调研资料投喂 (豆包 app 用户没 CLI · 压缩只能在服务端做)。
# 不配这个 key · 投喂功能仍能用 · 只是不压缩 · 只存全文 (前端提示"摘要暂缺")。
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat        # 可选 · 默认 deepseek-chat

# ============================================
# 飞书通知联动 (bridge 消息 → 飞书群 @ 收件人)
# ============================================
#
# 配上这三个 · server 收到 bridge 消息(接力/文件/消息)时主动往飞书通知群推一条并 @ 收件人。
# 团队所有人零配置就能收到 · 不用各自 login/set-chat/守护进程 · 新成员登录一次即可(注册 open_id)。
# 不配则 server 不推 · 客户端守护进程兜底(老行为)。凭证跟 CLI 用的同一个自建应用。
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_NOTIFY_CHAT_ID=oc_xxx      # tinker feishu chats 看群 id

# ============================================
# 后期扩展 (V2)
# ============================================

# AUTH_SECRET=...                   # OAuth session 签名
# DATABASE_URL=postgresql://...     # PG 迁移时用
# SENTRY_DSN=...                    # 错误追踪
